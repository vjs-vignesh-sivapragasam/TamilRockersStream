{
  "expo": {
    "name": "VFlix",
    "slug": "vflix",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "bundleIdentifier": "com.vflix.app",
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "LSApplicationQueriesSchemes": [
          "vlc",
          "vlc-x-callback",
          "outplayer",
          "infuse"
        ]
      }
    },
    "android": {
      "package": "com.vflix.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "largeHeap": true,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "./plugins/withKSPlayer",
      "expo-router",
      "expo-video",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "minSdkVersion": 26,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "abiFilters": [
              "arm64-v8a",
              "armeabi-v7a"
            ]
          }
        }
      ]
    ],
    "scheme": "vflix",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "11e42153-6578-4595-a79e-c21c6f6f70ed"
      }
    },
    "sdkVersion": "57.0.0",
    "runtimeVersion": "57.0.0",
    "updates": {
      "url": "https://u.expo.dev/11e42153-6578-4595-a79e-c21c6f6f70ed"
    }
  }
}
